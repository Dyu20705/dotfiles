# ──────────────────────────────────────────────────────────
#  TMUX CONFIGURATION (Hardened & Optimized)
# ──────────────────────────────────────────────────────────
# 
# Goals:
# - Minimize startup latency and runtime shell-outs
# - Keep configuration deterministic and debuggable
# - Ensure nested tmux, SSH, and local workflows work cleanly
# - Reserve cosmetics for explicit user configuration
#

# ── Section 1: Core Terminal & Session Settings ──────────────
set -g default-terminal "xterm-256color"
set -as terminal-overrides ",*:Tc"          # True color support for wezterm/kitty/alacritty

# Detect if we're in a nested tmux (for safety checks later)
set -g @is_nested_tmux "#{?TMUX,1,0}"

# ── Section 2: Leader Key & Prefix ──────────────────────────
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# ── Section 3: Session & Window Defaults ────────────────────
set -g mouse on
set -g base-index 1
set -g renumber-windows on
set -g mode-keys vi
set -g focus-events on                      # Improves focus handling in wezterm/kitty

# Prevent automatic exit when last window is closed
set -g exit-empty on

# ── Section 4: Window/Pane Navigation & Splitting ───────────
# Split panes while preserving current directory
unbind %
bind \\ split-window -h -c "#{pane_current_path}"
unbind '"'
bind - split-window -v -c "#{pane_current_path}"

# New window preserves directory
bind c new-window -c "#{pane_current_path}"

# Vim-style pane resizing (with -r flag allows key repeat without prefix)
bind -r j resize-pane -D 2
bind -r k resize-pane -U 2
bind -r h resize-pane -L 2
bind -r l resize-pane -R 2
bind -r m resize-pane -Z

# ── Section 5: Copy Mode & Clipboard ─────────────────────────
# Begin selection in copy mode
bind -T copy-mode-vi v send -X begin-selection
# tmux-yank handles copy/paste detection automatically

# Fallback clipboard paste (requires xclip/wl-paste/pbpaste on system)
bind -n C-v run "tmux set-buffer \"$(wl-paste 2>/dev/null || xclip -o -selection clipboard 2>/dev/null || pbpaste 2>/dev/null)\" ; tmux paste-buffer"
bind -n S-Insert run "tmux set-buffer \"$(wl-paste 2>/dev/null || xclip -o -selection clipboard 2>/dev/null || pbpaste 2>/dev/null)\" ; tmux paste-buffer"

# ── Section 6: Neovim Integration ───────────────────────────
# Open nvim in a split pane (portable, no hardcoded paths)
bind v split-window -h -c "#{pane_current_path}" "zsh -c 'nvim; exec zsh'"

# ── Section 7: Core Plugins (Essential Only) ────────────────
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'         # Sane defaults
set -g @plugin 'christoomey/vim-tmux-navigator'     # C-hjkl pane navigation
set -g @plugin 'tmux-plugins/tmux-yank'             # OS-aware clipboard
set -g @plugin 'tmux-plugins/tmux-resurrect'        # Session save/restore

# Note: tmux-continuum (auto-save) intentionally removed to avoid
# nondeterministic background saves. Use manual save (Prefix C-s).
# For optional plugins (weather, fzf, battery), load via ~/.tmux.conf.local

# ── 12. Cấu hình Catppuccin Theme ────────────────────────────
set -g @catppuccin_flavor "mocha"
set -g @catppuccin_window_status_style "basic"
set -g window-status-separator ""

set -g @catppuccin_window_current_text_color "#{@thm_surface_1}"
set -g @catppuccin_window_current_number_color "#{@thm_peach}"
set -g @catppuccin_window_current_text " #[bg=#{@thm_mantle}] #{b:pane_current_path}"

set -g @catppuccin_window_text " #W"
set -g @catppuccin_window_default_text "#W"
set -g @catppuccin_window_number_color "#{@thm_lavender}"

# ── 13. Status bar đa nền tảng ───────────────────────────────
set -g status-interval 10                          # Cập nhật nhanh hơn mà vẫn nhẹ
set -g status-right-length 120
set -g status-left "#[bg=#{@thm_green},fg=#{@thm_crust}]#[reverse]█#[noreverse]#S "
set -g status-style fg=default,bg=default

# Ghép các thành phần status-right một cách độc lập với HĐH
set -g status-right "#(bash ~/dotfiles/tmux/pomodoro.sh) #(bash ~/dotfiles/tmux/random_note.sh) "
set -agF status-right "#{E:@catppuccin_status_weather}"
set -agF status-right "#{E:@catppuccin_status_cpu}"
# Note: the above `#(...)` constructs spawn shell processes on each redraw.
# Recommended safer approach:
# 1) Use `tmux/build_status_cache.sh` (provided) to aggregate heavy commands
#    and write a single-line status into ~/.cache/tmux_status.
# 2) Populate a tmux option from that cache at load-time or via an external
#    updater (systemd timer):
#    run-shell -b 'tmux set-option -gq @tmux_cached_status "$(cat ~/.cache/tmux_status 2>/dev/null || true)"'
# 3) Use the option in the statusline (tmux-native format, no shell-outs):
#    set -g status-right "#{@tmux_cached_status}"

# Pin (chỉ hiện trên laptop)
set -agF status-right "#[bg=#{@thm_green},fg=#{@thm_crust}]#[reverse]█#[noreverse]󰁹 "
set -agF status-right "#[fg=#{@thm_fg},bg=#{@thm_mantle}]#{battery_status_bg} #{battery_percentage} "

# Bộ nhớ (tự động chọn lệnh theo OS)
set -agF status-right "#[bg=#{@thm_green},fg=#{@thm_crust}]#[reverse]█#[noreverse]󰘛 "
if-shell "uname -s | grep -q Darwin" {
    set -agF status-right "#[fg=#{@thm_fg},bg=#{@thm_mantle}] #(memory_pressure | awk '{print 100 - \$5}')%% "
}
if-shell "uname -s | grep -q Linux" {
    set -agF status-right "#[fg=#{@thm_fg},bg=#{@thm_mantle}] #(free -m | awk 'NR==2{printf \"%.0f\", \$3/\$2*100}')%% "
}

# Ngày giờ
set -agF status-right "#[bg=#{@thm_green},fg=#{@thm_crust}]#[reverse]█#[noreverse]󰢗 "
set -agF status-right "#[fg=#{@thm_fg},bg=#{@thm_mantle}] %m/%d:%H"

# ── 14. Pomodoro shortcuts ──────────────────────────────────
bind-key b command-prompt -p "Pomodoro (work/break/longbreak)" "run-shell '~/dotfiles/tmux/pomocmd.sh %%'"
bind-key 0 run-shell '~/dotfiles/tmux/pomodoro.sh stop'

# ── 15. Khởi chạy TPM (phải ở cuối file) ────────────────────
run '~/.tmux/plugins/tpm/tpm'

# ── 16. Các tinh chỉnh UI cuối ──────────────────────────────
set -g status-style bg=default
set -g message-style "bg=#{@thm_surface_0},fg=#{@thm_fg}"
