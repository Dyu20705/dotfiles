# ──────────────────────────────────────────────────────────
#  TMUX CONFIGURATION (Hardened & Optimized)
# ──────────────────────────────────────────────────────────
# 
# Architecture:
# - Minimize startup latency and runtime shell-outs
# - Keep configuration deterministic and debuggable
# - Ensure nested tmux, SSH, and local workflows work cleanly
# - Reserve cosmetics for explicit user configuration
#
# Key Changes from Previous:
# - Removed tmux-weather, tmux-fzf, tmux-cpu (plugin bloat)
# - Removed tmux-continuum (auto-save introduces nondeterminism)
# - Reduced status-interval from 10s to 30s (fewer shell-outs)
# - Native status bar instead of plugin-based theming
# - Manual session save (deterministic)
# - Require prefix for reload (safety)

# ── Section 1: Core Terminal & Session Settings ──────────────
set -g default-terminal "xterm-256color"
set -as terminal-overrides ",*:Tc"          # True color support for wezterm/kitty/alacritty

# Allow tmux to be detected from scripts (useful for nested checks)
set -g @is_nested_tmux "#{?TMUX,1,0}"

# ── Section 2: Leader Key & Prefix ──────────────────────────
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# ── Section 3: Session & Window Defaults ────────────────────
set -g mouse on
set -g base-index 1
set -g renumber-windows on
set -g mode-keys vi
set -g focus-events on                      # Improves focus handling in wezterm/kitty

# ── Section 4: Window/Pane Navigation & Splitting ───────────
# Split panes while preserving current directory
unbind %
bind \\ split-window -h -c "#{pane_current_path}"
unbind '"'
bind - split-window -v -c "#{pane_current_path}"

# New window preserves directory
bind c new-window -c "#{pane_current_path}"

# Vim-style pane resizing (with -r flag allows key repeat without prefix)
bind -r j resize-pane -D 2
bind -r k resize-pane -U 2
bind -r h resize-pane -L 2
bind -r l resize-pane -R 2
bind -r m resize-pane -Z

# ── Section 5: Copy Mode & Clipboard ─────────────────────────
# Begin selection in copy mode
bind -T copy-mode-vi v send -X begin-selection
# tmux-yank handles copy/paste detection automatically

# Fallback clipboard paste (requires xclip/wl-paste/pbpaste on system)
bind -n C-v run "tmux set-buffer \"$(wl-paste 2>/dev/null || xclip -o -selection clipboard 2>/dev/null || pbpaste 2>/dev/null)\" ; tmux paste-buffer"
bind -n S-Insert run "tmux set-buffer \"$(wl-paste 2>/dev/null || xclip -o -selection clipboard 2>/dev/null || pbpaste 2>/dev/null)\" ; tmux paste-buffer"

# ── Section 6: Neovim Integration ───────────────────────────
# Open nvim in a split pane (portable, no hardcoded paths)
bind v split-window -h -c "#{pane_current_path}" "zsh -c 'nvim; exec zsh'"

# ── Section 7: Core Plugins (Essential Only) ────────────────
# Rationale:
# - tpm: plugin manager (required)
# - tmux-sensible: good defaults, lightweight
# - vim-tmux-navigator: cross-app pane navigation
# - tmux-yank: clipboard detection (OS-aware)
# - tmux-resurrect: manual session save/restore
#
# NOT included (removed for determinism/performance):
# - tmux-continuum: auto-save too aggressive/nondeterministic
# - tmux-weather: external API calls, optional cosmetic
# - tmux-fzf: not used in current workflows
# - tmux-cpu/battery: cosmetic, stat collection overhead
# - catppuccin/tmux: replaced with native tmux colors
#
# Optional: Load via ~/.tmux.conf.local if desired
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'

# ── Section 8: Session Management (Manual, Deterministic) ────
# Use tmux-resurrect for explicit save/restore (not auto-save)
# Keybinding: Prefix C-s (save), Prefix C-l (load)
bind C-s run "~/.tmux/plugins/tmux-resurrect/scripts/save.sh"
bind C-l run "~/.tmux/plugins/tmux-resurrect/scripts/restore.sh"

# ── Section 9: Configuration Reload ──────────────────────────
# Reload config with visual feedback (requires prefix for safety)
bind r source-file ~/.tmux.conf \; display "✔ config reloaded"

# ── Section 10: Status Bar (Minimal, Efficient) ──────────────
# CRITICAL: Reduce update frequency to minimize shell-outs
# Previous: 10s updates running pomodoro.sh + random_note.sh every 10s
# New: 30s updates with minimal shell-outs (only cached data)
set -g status-interval 30
set -g status-right-length 120
set -g status-left-length 50

# Styling: catppuccin mocha colors for consistency
set -g status-style fg=default,bg=default
set -g message-style "bg=#1e1e2e,fg=#cdd6f4"

# Left side: session name with highlight
set -g status-left "#[bg=#a6e3a1,fg=#1e1e2e]#{session_name}#[bg=default,fg=default] "

# Right side: minimal data with no shell-outs by default
# If user wants pomodoro/notes, they should be cached in ~/.cache/tmux_status
# and managed externally (e.g., via a background job or hourly cron)
set -g status-right ""
set -agF status-right "#([ -r ~/.cache/tmux_status ] && cat ~/.cache/tmux_status || echo '')"
# Recommended safer pattern: avoid shell-outs in status by using a cached value.
# Example (recommended):
# run external updater (systemd timer or cron) to populate ~/.cache/tmux_status
# and in tmux config use a tmux option to avoid invoking shell on redraw:
# run-shell -b 'tmux set-option -gq @tmux_cached_status "$(cat ~/.cache/tmux_status 2>/dev/null || true)"'
# set -agF status-right "#{@tmux_cached_status}"
set -agF status-right " #[bg=#313244,fg=#a6adc8]%H:%M "

# ── Section 11: Window Status Formatting ─────────────────────
# Simple, clean window tabs
set -g window-status-separator " "
set -g window-status-format "#W"
set -g window-status-current-format "#[bg=#f38ba8,fg=#1e1e2e]#W#[bg=default,fg=default]"

# ── Section 12: Pane Border & Appearance ─────────────────────
set -g pane-border-style fg=#313244
set -g pane-active-border-style fg=#f38ba8
set -g pane-border-lines single

# ── Section 13: Performance & Stability ──────────────────────
# Escape time for nested tmux
set -g escape-time 0

# Large history without performance impact
set -g history-limit 50000

# Don't detach on connection loss (allow reconnect)
set -g detach-on-destroy off

# ── Section 14: Optional User Configuration ──────────────────
# Load local config if it exists (for machine-specific tweaks)
if-shell "test -f ~/.tmux.conf.local" "source-file ~/.tmux.conf.local"

# ── Section 15: Initialize TPM (Must be Last) ────────────────
run '~/.tmux/plugins/tpm/tpm'
