{
  "schema_version": 1,
  "root_env": "DOTFILES_ROOT",
  "profiles": {
    "minimal": {
      "description": "Git, recovery commands and script runtime"
    },
    "normal": {
      "description": "Daily Ubuntu workflow with Zsh, tmux and Neovim"
    },
    "full": {
      "description": "Normal workflow plus WezTerm, LazyGit and optional helpers"
    }
  },
  "contexts": {
    "desktop": {
      "description": "Ubuntu desktop with GUI and local clipboard"
    },
    "laptop": {
      "description": "Ubuntu laptop with conservative background work"
    },
    "server": {
      "description": "Headless local machine; defaults to minimal side effects"
    },
    "remote": {
      "description": "SSH or CI session; defaults to minimal side effects"
    }
  },
  "apps": [
    {
      "name": "bash",
      "command": "bash",
      "minimum": "4.0",
      "required_in": [
        "minimal",
        "normal",
        "full"
      ]
    },
    {
      "name": "git",
      "command": "git",
      "minimum": "2.40",
      "required_in": [
        "minimal",
        "normal",
        "full"
      ]
    },
    {
      "name": "jq",
      "command": "jq",
      "minimum": "1.6",
      "required_in": [
        "minimal",
        "normal",
        "full"
      ]
    },
    {
      "name": "zsh",
      "command": "zsh",
      "minimum": "5.8",
      "required_in": [
        "normal",
        "full"
      ]
    },
    {
      "name": "tmux",
      "command": "tmux",
      "minimum": "3.2",
      "required_in": [
        "normal",
        "full"
      ]
    },
    {
      "name": "nvim",
      "command": "nvim",
      "minimum": "0.11.3",
      "required_in": [
        "normal",
        "full"
      ]
    },
    {
      "name": "wezterm",
      "command": "wezterm",
      "minimum": null,
      "required_in": [
        "full"
      ]
    },
    {
      "name": "lazygit",
      "command": "lazygit",
      "minimum": null,
      "required_in": []
    },
    {
      "name": "docker",
      "command": "docker",
      "minimum": null,
      "required_in": []
    },
    {
      "name": "fzf",
      "command": "fzf",
      "minimum": null,
      "required_in": []
    },
    {
      "name": "zoxide",
      "command": "zoxide",
      "minimum": null,
      "required_in": []
    },
    {
      "name": "starship",
      "command": "starship",
      "minimum": null,
      "required_in": []
    },
    {
      "name": "direnv",
      "command": "direnv",
      "minimum": null,
      "required_in": []
    },
    {
      "name": "atuin",
      "command": "atuin",
      "minimum": null,
      "required_in": []
    },
    {
      "name": "shellcheck",
      "command": "shellcheck",
      "minimum": null,
      "required_in": []
    },
    {
      "name": "yamllint",
      "command": "yamllint",
      "minimum": null,
      "required_in": []
    }
  ],
  "packages": {
    "minimal": [
      "bash",
      "git",
      "jq",
      "curl",
      "ca-certificates"
    ],
    "normal": [
      "bash",
      "git",
      "jq",
      "curl",
      "ca-certificates",
      "zsh",
      "tmux",
      "neovim",
      "ripgrep",
      "fd-find",
      "fzf",
      "bat",
      "eza",
      "direnv",
      "wl-clipboard",
      "xclip"
    ],
    "full": [
      "bash",
      "git",
      "jq",
      "curl",
      "ca-certificates",
      "zsh",
      "tmux",
      "neovim",
      "ripgrep",
      "fd-find",
      "fzf",
      "bat",
      "eza",
      "direnv",
      "wl-clipboard",
      "xclip",
      "mpv",
      "docker.io",
      "docker-compose-v2"
    ]
  },
  "commands": [
    "dot",
    "dev",
    "gw"
  ],
  "performance_budgets_ms": {
    "git": 250,
    "zsh": 500,
    "tmux": 800,
    "nvim": 1200,
    "wezterm": 1500
  },
  "capability_packs": [
    "system"
  ],
  "links": [
    {
      "source": "zsh/.zshrc",
      "target": "~/.zshrc",
      "profiles": [
        "normal",
        "full"
      ]
    },
    {
      "source": "tmux/tmux.conf",
      "target": "~/.tmux.conf",
      "profiles": [
        "normal",
        "full"
      ]
    },
    {
      "source": "nvim/.config/nvim",
      "target": "~/.config/nvim",
      "profiles": [
        "normal",
        "full"
      ]
    },
    {
      "source": "wezterm/.wezterm.lua",
      "target": "~/.wezterm.lua",
      "profiles": [
        "full"
      ]
    },
    {
      "source": "git/.gitconfig",
      "target": "~/.gitconfig",
      "profiles": [
        "minimal",
        "normal",
        "full"
      ]
    },
    {
      "source": "lazygit/config.yml",
      "target": "~/.config/lazygit/config.yml",
      "profiles": [
        "full"
      ]
    },
    {
      "source": "scripts/open.sh",
      "target": "~/.local/bin/dotfiles-open",
      "profiles": [
        "minimal",
        "normal",
        "full"
      ]
    },
    {
      "source": "scripts/wezterm-media.sh",
      "target": "~/.local/bin/dotfiles-wezterm-media",
      "profiles": [
        "full"
      ]
    },
    {
      "source": "scripts/doctor.sh",
      "target": "~/.local/bin/dotfiles-doctor",
      "profiles": [
        "minimal",
        "normal",
        "full"
      ]
    },
    {
      "source": "scripts/dot",
      "target": "~/.local/bin/dot",
      "profiles": [
        "minimal",
        "normal",
        "full"
      ]
    },
    {
      "source": "scripts/dev",
      "target": "~/.local/bin/dev",
      "profiles": [
        "normal",
        "full"
      ]
    },
    {
      "source": "scripts/gw",
      "target": "~/.local/bin/gw",
      "profiles": [
        "normal",
        "full"
      ]
    },
    {
      "source": "completions/_dot",
      "target": "~/.local/share/zsh/site-functions/_dot",
      "profiles": [
        "normal",
        "full"
      ]
    },
    {
      "source": "completions/_dev",
      "target": "~/.local/share/zsh/site-functions/_dev",
      "profiles": [
        "normal",
        "full"
      ]
    },
    {
      "source": "completions/_gw",
      "target": "~/.local/share/zsh/site-functions/_gw",
      "profiles": [
        "normal",
        "full"
      ]
    }
  ]
}
